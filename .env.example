COMPOSE_PROJECT_NAME=fs-monitoring

# Generated by scripts/init-secrets.sh. Do not use these placeholders.
HOMER_ADMIN_USER=admin
HOMER_ADMIN_PASSWORD=replace-me
HOMER_ADMIN_PASSWORD_HASH=replace-me-with-sha256
HOMER_FLIGHT_TOKEN=replace-me
HOMER_JWT_SECRET=replace-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Only HEP is public by default. Keep the web UIs on loopback and use an SSH
# tunnel, VPN, or authenticated TLS reverse proxy.
HEP_BIND_ADDRESS=0.0.0.0
UI_BIND_ADDRESS=127.0.0.1
HOMER_UI_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
PUSHGATEWAY_PORT=9091
GRAFANA_COOKIE_SECURE=false

# Copy alertmanager/alertmanager.yml to this untracked local path before adding
# real notification credentials.
ALERTMANAGER_CONFIG_PATH=./alertmanager/alertmanager.yml

# Retention and resource defaults for an 8-vCPU/24-GB/300-GB monitoring VPS.
HOMER_RETENTION_DAYS=14
HOMER_INGEST_WORKERS=8
HOMER_MEMORY_LIMIT=6GB
HOMER_DUCKDB_THREADS=4
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=40GB

# Image versions are pinned for repeatable upgrades.
HOMER_IMAGE=ghcr.io/sipcapture/homer:11.0.333
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.0
LOKI_IMAGE=grafana/loki:3.7.7
GRAFANA_IMAGE=grafana/grafana:13.2.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.28.0
PUSHGATEWAY_IMAGE=prom/pushgateway:v1.11.3
