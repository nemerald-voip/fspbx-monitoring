[Unit]
# Compatibility unit for existing installations; new hosts use fspbx-access.
Description=Apply PBX access restrictions (legacy HEP firewall unit)
Requires=docker.service
After=docker.service
Before=monitoring-reconcile.service
PartOf=docker.service
ConditionPathExists=/etc/fs-monitoring/hep-firewall.env

[Service]
Type=oneshot
EnvironmentFile=/etc/fs-monitoring/hep-firewall.env
ExecStart=/opt/monitoring/ops/apply-hep-firewall.sh
ExecReload=/opt/monitoring/ops/apply-hep-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
