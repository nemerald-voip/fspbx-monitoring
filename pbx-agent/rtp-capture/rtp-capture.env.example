# Interface and FreeSWITCH RTP range from switch.conf.xml.
CAPTURE_INTERFACE=eth0
RTP_PORT_START=16384
RTP_PORT_END=32768

# 128-byte snapshots retain IP/UDP/RTP headers but not the full audio payload.
SNAP_LENGTH=128

# A hard 8-GiB ring: 32 files * 262144 KiB. Oldest files are overwritten.
RING_FILE_KIB=262144
RING_FILE_COUNT=32
CAPTURE_DIRECTORY=/var/capture
