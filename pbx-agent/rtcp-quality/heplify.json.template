{
  "socket": [
    {
      "name": "sip-correlation-only",
      "active": true,
      "socket_type": "afpacket",
      "sequential_processing": true,
      "transport_profile": ["correlation-only"],
      "device": "@@INTERFACE@@",
      "promisc": false,
      "tcp_reasm": true,
      "sip_reasm": true,
      "ipfragments": true,
      "snap_len": 8192,
      "capture_mode": ["SIP"],
      "fanout_workers": 0,
      "buffer_size_mb": 32,
      "bpf_filter": "((tcp or sctp) and greater 42 and portrange @@SIP_START@@-@@SIP_END@@) or (udp and greater 128 and portrange @@SIP_START@@-@@SIP_END@@)"
    },
    {
      "name": "rtcp-to-homer",
      "active": true,
      "socket_type": "afpacket",
      "sequential_processing": true,
      "transport_profile": ["homer"],
      "device": "@@INTERFACE@@",
      "promisc": false,
      "tcp_reasm": false,
      "sip_reasm": false,
      "ipfragments": true,
      "snap_len": 2048,
      "capture_mode": ["RTCP"],
      "fanout_workers": 0,
      "buffer_size_mb": 32,
      "bpf_filter": "ip and udp and portrange @@RTP_START@@-@@RTP_END@@ and udp[8] & 0xc0 = 0x80 and udp[9] >= 0xc8 and udp[9] <= 0xdf"
    }
  ],
  "transport": [
    {
      "name": "homer",
      "active": true,
      "failover_only": false,
      "protocol": "HEPv3",
      "host": "@@MONITORING_HOST@@",
      "transport": "@@HEP_TRANSPORT@@",
      "port": 9060,
      "password": "",
      "payload_zip": false,
      "skip_verify": false,
      "keepalive": 5,
      "max_retries": 0
    }
  ],
  "log_settings": {
    "active": true,
    "level": "info",
    "stdout": true,
    "json": true,
    "log_payload": false
  },
  "protocol": [
    {
      "name": "SIP",
      "min_port": @@SIP_START@@,
      "max_port": @@SIP_END@@,
      "protocol": ["udp", "tcp"],
      "description": "SIP/SDP parsing for RTCP correlation; no HEP transport"
    },
    {
      "name": "RTCP",
      "min_port": @@RTP_START@@,
      "max_port": @@RTP_END@@,
      "protocol": ["udp"],
      "description": "RTCP sender, receiver, and extended reports"
    }
  ],
  "sip_settings": {
    "discard_methods": [],
    "discard_ips": [],
    "discard_src_ips": [],
    "discard_dst_ips": [],
    "deduplicate": true
  },
  "hep_settings": {
    "replace_token": false,
    "deduplicate": true,
    "collect_only_sip": false
  },
  "rtcp_settings": {
    "active": true
  },
  "system_settings": {
    "node_name": "@@NODE_NAME@@",
    "node_id": @@CAPTURE_ID@@,
    "node_pw": "",
    "uuid": ""
  },
  "prometheus_settings": {
    "active": false,
    "host": "127.0.0.1",
    "port": 9096,
    "auth": false,
    "sip_methods": [],
    "carriers": []
  },
  "api_settings": {
    "active": false,
    "host": "127.0.0.1",
    "port": 8008,
    "username": "",
    "password": "",
    "tls": false,
    "cert_file": "",
    "key_file": ""
  },
  "debug_settings": {
    "disable_tcp_reassembly": false,
    "disable_ip_defrag": false
  },
  "pcap_settings": {
    "write_file": "",
    "rotate_minutes": 60,
    "compress": false
  },
  "buffer_settings": {
    "enable": false,
    "file": "",
    "max_size": 0,
    "debug": false
  },
  "script_settings": {
    "active": false,
    "file": "",
    "hep_filter": ""
  },
  "collector_settings": {
    "active": false,
    "host": "127.0.0.1",
    "port": 9060,
    "proto": "udp"
  }
}
