[Unit]
Description=FreeSWITCH ESL RTCP quality reporter for HOMER
Documentation=https://github.com/nemerald-voip/fspbx-monitoring
Wants=network-online.target
After=network-online.target freeswitch.service
ConditionPathExists=/etc/freeswitch-rtcp-to-hep/config.json
ConditionPathExists=/etc/freeswitch-rtcp-to-hep/esl-password
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=true
LoadCredential=esl_password:/etc/freeswitch-rtcp-to-hep/esl-password
ExecStart=/usr/bin/python3 /usr/local/sbin/freeswitch-rtcp-to-hep --config /etc/freeswitch-rtcp-to-hep/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
CPUWeight=10
MemoryHigh=48M
MemoryMax=96M
MemorySwapMax=0
TasksMax=16
OOMScoreAdjust=500
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
